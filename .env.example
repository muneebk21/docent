# Postgres (used by docker-compose.yml)
POSTGRES_DB=docent
POSTGRES_USER=docent
POSTGRES_PASSWORD=docent

# Full connection string the NestJS app will use (pg client)
DATABASE_URL=postgresql://docent:docent@localhost:5432/docent

# Groq API key (OpenAI-compatible endpoint) for the generation step
GROQ_API_KEY=

# Port the NestJS app listens on (optional, defaults to 3000)
PORT=3000
